#!/bin/bash
#
# Switch the Claude Desktop app between saved claude.ai accounts, without an email code.
#
# - List saved accounts; `*` marks the one signed in now:
#
# `claude-multipass list`
#
# - Pick a saved account with fzf and switch to it (bare on a terminal, or `pick`):
#
# `claude-multipass`
#
# - Show one saved account and its Code-tab session count per org:
#
# `claude-multipass show {{name}}`
#
# - Save the account signed in now under a name, the terminal's claude login with it (quits and relaunches Claude):
#
# `claude-multipass save {{name}}`
#
# - Switch to a saved account (Desktop and the terminal's claude login) and sync the Code tab's session list:
#
# `claude-multipass switch {{name}}`
#
# - Make every account's Claude Code sessions show in every account's Code tab:
#
# `claude-multipass sync`
#
# - Sign out locally so a new account can sign in, then save it under that name:
#
# `claude-multipass add {{name}}`
#
# - Rename a saved account, or remove one (it moves to the backups folder; its CLI token is deleted):
#
# `claude-multipass rename {{old}} {{new}}`
#
# - Show each saved account's 5-hour and weekly usage (reads the saved tokens, see --help):
#
# `claude-multipass usage`
#
# - Print the name of the signed-in saved account (for scripts and Raycast):
#
# `claude-multipass current`
#
# - Check the setup (config, tools, store modes, profile tokens, CLI logins); exits 1 on a fail: line:
#
# `claude-multipass doctor`
#
# - Full help, with the flags, folders and cautions:
#
# `claude-multipass --help`
#
# - Print the version:
#
# `claude-multipass --version`
#
# - List or usage as JSON, for scripts and the menu bar app:
#
# `claude-multipass list --json`
#
# - Leave Claude quit afterwards (save, switch, add):
#
# `claude-multipass switch {{name}} --no-relaunch`
#
# - Sync while Claude runs, or switch away from a login that was never saved:
#
# `claude-multipass sync --force`
#
# ---
# Mechanism: a Desktop login is three keys of config.json (oauth:tokenCache,
# oauth:tokenCacheV2, lastKnownAccountUuid) plus the Cookies and
# Cookies-journal files (in Network/ when that folder exists). The app
# encrypts them with its own Keychain key; they are copied as opaque bytes.
# The Code tab lists one claude-code-sessions/<account>/<org>/local_<id>.json
# pointer per session, with no account field, while transcripts live in the
# shared ~/.claude/projects, so copying a pointer shows the session to another
# account. A deleted_<id> file marks a session the user deleted; sync never
# copies it back and never deletes anything.
#
# Profiles: ${CLAUDE_MULTIPASS_DIR:-${XDG_CONFIG_HOME:-~/.config}/claude-multipass}/profiles/<name>/
# (config.json, Cookies, Cookies-journal, meta.json, cli.json). The Claude Code
# CLI's login is a login-Keychain item (service "Claude Code-credentials") plus
# oauthAccount in ~/.claude.json; save copies the tokens into a Keychain item
# of the tool's own (service claude-multipass, account <name>) and the identity
# into cli.json, when the CLI is signed in as the same account as Desktop. The
# token goes to the Keychain helper on stdin, never on a command line.
# The backups/ folder beside it keeps the login (config.json and cookies) each
# switch or add replaced, newest ten, plus any profile `save --force` replaced.
# A store left by the tool's earlier life in a dotfiles repo
# (~/.config/dotfiles/claude-desktop-accounts) is moved into place once, on
# the first run that finds it and no new store; its -backups sibling moves
# too unless backups/ already exists, in which case the run warns.
# Never use the app's own Log out to change accounts: it may revoke the
# saved token server-side. Use `add`.
# Desktop folder: ${CLAUDE_DESKTOP_DIR:-~/Library/Application Support/Claude}.
#
# Any number of accounts, any Mac: nothing here names an account or a
# machine. Profiles are per Mac, though: the app encrypts the login with a
# key in that Mac's login Keychain ("Claude Safe Storage"), so a profile
# copied to another Mac won't decrypt. Save each account once per Mac.
# macOS only (osascript, open, security, Application Support paths); needs jq
# and the Command Line Tools (their /usr/bin/python3 reads and writes the CLI
# login's Keychain items); fzf for the picker; curl and openssl for usage.
#
# Bare invocation on a terminal with fzf runs `pick`; `pick` and `current`
# are also commands, for scripts and the self-check. The self-check stubs
# security, the Keychain helper (CLAUDE_MULTIPASS_KEYCHAIN, stateful) and curl
# on PATH, so the CLI login paths and `usage` run without the Keychain or
# network.
#
# config.json.journal is left alone: it is the app's write-ahead copy, headed
# by the sha256 of the config.json it was taken from, and the app discards it
# at startup when that digest no longer matches (as after a switch).
#
# Follow-up: Desktop projects (spaces) in
# local-agent-mode-sessions/<account>/<org>/spaces.json and the per-org
# archived-sessions.idx (which sessions show as archived) are not synced yet.
#
# Based on github.com/snlperstripes/claude-account-switcher (Go, tray app).
#
# License: MIT

set -euo pipefail

version=0.3.1

desktop_dir="${CLAUDE_DESKTOP_DIR:-$HOME/Library/Application Support/Claude}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
root="${CLAUDE_MULTIPASS_DIR:-$config_home/claude-multipass}"
store="$root/profiles"
backups="$root/backups"
config="$desktop_dir/config.json"
sessions="$desktop_dir/claude-code-sessions"
cookies=$desktop_dir
[[ -d $desktop_dir/Network ]] && cookies=$desktop_dir/Network
auth_keys='["oauth:tokenCache","oauth:tokenCacheV2","lastKnownAccountUuid"]'
# The Claude Code CLI keeps its own login: a login-Keychain item (service
# "Claude Code-credentials", account the macOS user name) with the OAuth
# tokens, and the oauthAccount object in ~/.claude.json naming the account
# and org. A profile's copy of the tokens is a Keychain item under the tool's
# own service, named after the profile; only the identity goes on disk.
claude_json="${CLAUDE_CLI_CONFIG:-$HOME/.claude.json}"
cli_home="${CLAUDE_CLI_HOME:-$HOME/.claude}"
cli_service='Claude Code-credentials'
cli_account=${USER:-$(id -un)}
mp_service=claude-multipass
# The CLI login items are read and written through the Security framework from
# the system python3 (the self-check points this at a stub). `security -i`
# keeps at most 4019 bytes of a line (measured) and a live CLI item with MCP
# logins runs to 15 KB, while `security -w` on argv would put the token on a
# command line. The helper takes the value on stdin, any length, any bytes.
keychain_helper="${CLAUDE_MULTIPASS_KEYCHAIN:-/usr/bin/python3}"
read -r -d '' keychain_py << 'PY' || true
import ctypes, ctypes.util, sys
op, service, account = sys.argv[1], sys.argv[2], sys.argv[3]
CF = ctypes.CDLL(ctypes.util.find_library("CoreFoundation"))
Sec = ctypes.CDLL(ctypes.util.find_library("Security"))
CF.CFStringCreateWithCString.restype = ctypes.c_void_p
CF.CFStringCreateWithCString.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_uint32]
CF.CFDataCreate.restype = ctypes.c_void_p
CF.CFDataCreate.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_long]
CF.CFDictionaryCreate.restype = ctypes.c_void_p
CF.CFDictionaryCreate.argtypes = [ctypes.c_void_p] * 3 + [ctypes.c_long, ctypes.c_void_p, ctypes.c_void_p]
CF.CFDataGetLength.restype = ctypes.c_long
CF.CFDataGetLength.argtypes = [ctypes.c_void_p]
CF.CFDataGetBytePtr.restype = ctypes.c_void_p
CF.CFDataGetBytePtr.argtypes = [ctypes.c_void_p]
Sec.SecItemCopyMatching.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p)]
Sec.SecItemUpdate.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
Sec.SecItemAdd.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
Sec.SecItemDelete.argtypes = [ctypes.c_void_p]
def cfstr(t): return CF.CFStringCreateWithCString(None, t.encode(), 0x08000100)
def const(lib, n): return ctypes.c_void_p.in_dll(lib, n).value
# The callback symbols are structs, so their address is what CF wants; a
# .value read would hand it the struct's first word (0, no callbacks).
def struct_addr(lib, n): return ctypes.addressof(ctypes.c_char.in_dll(lib, n))
def cfdict(pairs):
    keys = (ctypes.c_void_p * len(pairs))(*[k for k, _ in pairs])
    vals = (ctypes.c_void_p * len(pairs))(*[v for _, v in pairs])
    return CF.CFDictionaryCreate(None, keys, vals, len(pairs), struct_addr(CF, "kCFTypeDictionaryKeyCallBacks"), struct_addr(CF, "kCFTypeDictionaryValueCallBacks"))
query = [(const(Sec, "kSecClass"), const(Sec, "kSecClassGenericPassword")), (const(Sec, "kSecAttrService"), cfstr(service)), (const(Sec, "kSecAttrAccount"), cfstr(account))]
NOTFOUND = -25300
if op == "get":
    out = ctypes.c_void_p()
    st = Sec.SecItemCopyMatching(cfdict(query + [(const(Sec, "kSecReturnData"), const(CF, "kCFBooleanTrue"))]), ctypes.byref(out))
    if st == 0: sys.stdout.buffer.write(ctypes.string_at(CF.CFDataGetBytePtr(out), CF.CFDataGetLength(out)))
elif op == "put":
    value = sys.stdin.buffer.read()
    data = CF.CFDataCreate(None, value, len(value))
    st = Sec.SecItemUpdate(cfdict(query), cfdict([(const(Sec, "kSecValueData"), data)]))
    if st == NOTFOUND: st = Sec.SecItemAdd(cfdict(query + [(const(Sec, "kSecValueData"), data)]), None)
elif op == "delete":
    st = Sec.SecItemDelete(cfdict(query))
else:
    st = 1
if st not in (0, NOTFOUND):
    why = {-25293: "access denied (the Keychain prompt was declined, or the password was wrong)",
           -25308: "no Keychain prompt is possible here (run it from a logged-in terminal, not SSH or a hook)",
           -128: "the Keychain prompt was cancelled",
           -25299: "the item already exists"}.get(st, "")
    print("keychain %s %s: OSStatus %d %s" % (op, service, st, why), file=sys.stderr)
sys.exit(0 if st == 0 else 44 if st == NOTFOUND else 1)
PY

bold=$(tput bold 2> /dev/null || true)
yellow=$(tput setaf 3 2> /dev/null || true)
red=$(tput setaf 1 2> /dev/null || true)
reset=$(tput sgr0 2> /dev/null || true)

info() { echo "${bold}$*${reset}"; }
warning() { echo "${yellow}$*${reset}" >&2; }
fail() {
  echo "${red}$*${reset}" >&2
  exit 1
}
# A refusal that --force lifts, so a caller can offer the override
refuse() {
  echo "${red}$*${reset}" >&2
  exit 3
}

usage() {
  cat << EOF
${bold}claude-multipass${reset}
Switch the Claude Desktop app between claude.ai accounts you have saved, without
typing an email code each time. After a switch, the Code tab lists the Claude
Code sessions of every saved account, so you can continue where you left off.

${bold}Usage${reset}
  claude-multipass                    open a picker of saved accounts
  claude-multipass list
  claude-multipass show <name>
  claude-multipass save|add|switch|remove <name> [--no-relaunch] [--force]
  claude-multipass rename <old> <new>
  claude-multipass sync [--force]
  claude-multipass usage [name]
  claude-multipass current
  claude-multipass doctor

${bold}First time, once per account${reset}
  claude-multipass save personal   # the account Desktop is signed in as
  claude-multipass add work        # relaunches at the sign-in screen;
                                         # sign in with the email code, then:
  claude-multipass save work

${bold}Every day${reset}
  claude-multipass switch personal # relaunches as personal, with both
                                         # accounts' sessions in the Code tab

${bold}Commands${reset}
  (no command)         Opens a list of your saved accounts in fzf. Enter
                       switches to the highlighted one; esc changes nothing.
                       Without a terminal or without fzf, prints this page.
  list                 Prints every saved account on one line: name, the first
                       eight characters of its account id, when it was saved,
                       and how many Code sessions it has. A leading * marks the
                       account Desktop is signed in as right now. With --json,
                       one object: version, signedIn, desktopRunning, current
                       (null when the login has no name) and profiles (name,
                       account, savedAt, sessions, cliSaved).
  show <name>          Prints one saved account in detail, including its Code
                       session count per organization. The picker shows this
                       as its preview.
  save <name>          Stores the login Desktop currently has under <name>, so
                       you can switch back to it later without an email code.
                       Desktop quits and relaunches, still signed in. The
                       terminal's claude login is saved too when it is signed
                       in as the same account; otherwise save warns and keeps
                       the profile's earlier CLI login. If <name>
                       already holds a different account, save stops; add
                       --force to replace it (the old profile is kept in the
                       backups folder).
  add <name>           Prepares Desktop for signing in to another account: the
                       current login is saved (if it has a name), Desktop
                       relaunches at its sign-in screen, and you sign in with
                       the email code, then claude auth login for the
                       terminal. Then run: save <name>
  switch <name>        Quits Desktop, puts the saved login for <name> in place,
                       copies every account's Code session entries into every
                       account's list, and relaunches Desktop signed in as
                       <name>. The login you are leaving is re-saved first. If
                       that login was never saved, switch stops so you do not
                       lose it; add --force to proceed anyway. When the profile
                       holds a CLI login, the terminal's claude login moves too,
                       whatever account it was on (the live one is backed up
                       first); a profile without one moves Desktop only, with
                       a warning. The re-save on the way out keeps the leaving
                       profile's CLI login only when the CLI is still signed in
                       as that account. Quit running claude sessions first:
                       one keeps its old token.
  sync                 Copies every saved account's Code session entries into
                       every other account's list, without changing accounts.
                       switch already does this; run sync by itself when a
                       session is missing from the Code tab. Desktop must be
                       quit, because it rewrites these files while it runs;
                       add --force to run while it is open.
  rename <old> <new>   Renames a saved account, its CLI login item with it.
                       Nothing else changes.
  remove <name>        Removes a saved account by moving its folder to the
                       backups folder and deleting its CLI login item (the
                       Desktop login is recoverable from the backup, the CLI
                       token is not). Desktop's current login is untouched.
  usage [name]         Prints each saved account's 5-hour and weekly usage as a
                       percentage, with the time each window resets. Give a
                       name to see one account. Opt-in; see Cautions. With
                       --json, {"profiles":[{name, fiveHour, sevenDay} or
                       {name, error}]}; each window has utilization and
                       resetsAt (UTC, Z).
  current              Prints the name of the saved account Desktop is signed
                       in as, "not saved" if the current login has no name, or
                       "signed out". For scripts and the Raycast commands.
  pick                 Opens the fzf picker, the same as running the command
                       with no arguments.
  doctor               Checks the setup: Desktop's config.json, the tools on
                       PATH, the store and profile modes, each profile's token,
                       the backups count, whether Desktop runs, which profiles
                       hold no CLI login, whether CLAUDE_CONFIG_DIR is set. One
                       ok:, warn: or fail: line per check; exits 1 on any
                       fail:. Reads no Keychain and no network.

${bold}Options${reset}
  --no-relaunch        Leave Desktop quit after save, switch, add or pick,
                       instead of relaunching it.
  --force              save: replace a profile that holds a different account.
                       switch: proceed even though the current login was never
                       saved. sync: run while Desktop is open. A refusal
                       exits 3.
  -h, --help           This page.
  --version            Print the version.
  --json               list, usage: print JSON instead of text, for scripts and
                       the menu bar app.

${bold}Folders${reset}
  Profiles   $store/<name>/
  Backups    $backups/
             (the last ten replaced logins, plus replaced or removed profiles)
  Desktop    $desktop_dir

${bold}Cautions${reset}
  - Never use Desktop's own Log out to change accounts; it may revoke the
    saved token on the server. Use add or switch instead.
  - Sign in with the email code, not Google, so the browser hand-back lands
    in the right window.
  - Profiles are per Mac: the app encrypts them with this Mac's Keychain key.
    Save each account once on every Mac you use.
  - usage decrypts the saved tokens with this Mac's Keychain key and reads
    Anthropic's OAuth usage endpoint with them, outside the app. Third-party
    coverage says Anthropic's terms discourage that pattern. It is read-only
    and only runs when you ask for it, or when you turn usage on in the menu
    bar app (polled at least 5 minutes apart). Whether to use it is your
    decision.
    The derived AES key is on the openssl command line for the moment of each
    decrypt (visible in ps to any local user while it runs).
  - Chats, Projects and memory on claude.ai stay with their account. Only
    Claude Code sessions carry over.
  - save, switch and add refuse from a shell inside Desktop (the Code tab's
    terminal): quitting Desktop would end that shell. Use Terminal or the
    menu bar app.
EOF
}

# The app writes config.json tab-indented, no final newline, mode 0600; match
# it so only the touched keys change and the token file stays private.
jq_write() {
  local dest=$1 out
  shift
  out=$(jq --tab "$@")
  (umask 077 && printf '%s' "$out" > "$dest.tmp")
  mv "$dest.tmp" "$dest"
}

# The helper exits 44 when the item is absent, like the security tool, and on
# any other failure names the OSStatus on stderr, which stays visible: it
# never carries a value, and the app shows stderr under the row.
keychain() { "$keychain_helper" -I -c "$keychain_py" "$@"; }
keychain_get() { keychain get "$1" "$2"; }

# The value (stdin) never touches argv. $(cat) drops the newline a here-string
# appends, which the CLI's own reader would not expect.
keychain_put() {
  local v
  v=$(cat)
  printf %s "$v" | keychain put "$1" "$2" > /dev/null
}

keychain_delete() {
  local rc=0
  keychain delete "$1" "$2" > /dev/null || rc=$?
  [[ $rc -eq 0 || $rc -eq 44 ]]
}

# The account uuid the CLI is signed in as, or nothing when signed out. It is
# the same claude.ai account id Desktop stores as lastKnownAccountUuid, so
# equality with the live Desktop account is the fingerprint that proves the
# CLI login belongs to the profile being saved.
cli_signed_in_as() { jq -r '.oauthAccount.accountUuid // empty' "$claude_json" 2> /dev/null || true; }

# The live CLI item, read once per run: the re-save on the way out and the
# restore right after it share the read (one Keychain prompt fewer). Status
# 44 (absent) is cached too; any other failure is retried by the next caller.
cli_live='' cli_live_rc=''
cli_live_read() {
  local rc=0
  [[ -z $cli_live_rc ]] || return "$cli_live_rc"
  cli_live=$(keychain_get "$cli_service" "$cli_account") || rc=$?
  [[ $rc -ne 0 && $rc -ne 44 ]] || cli_live_rc=$rc
  return "$rc"
}

# The CLI is skipped for this run (a held lock on save or add).
cli_skip=''

# Why the CLI part of this run is impossible, or nothing. Shared by the
# capture and the restore so the two never disagree.
cli_blocker() {
  [[ -z ${CLAUDE_CONFIG_DIR:-} ]] || echo "CLAUDE_CONFIG_DIR is set; the CLI login is not saved or switched"
  # Without the Command Line Tools /usr/bin/python3 is a shim that pops the
  # installer dialog; xcode-select -p answers without one.
  xcode-select -p > /dev/null 2>&1 || echo "the Command Line Tools are not installed (xcode-select --install)"
  [[ -f $claude_json ]] || echo "Claude Code has not run on this Mac"
  [[ ! -f $claude_json ]] || jq -e . "$claude_json" > /dev/null 2>&1 || echo "$claude_json is not valid JSON"
}

# The CLI part of a save: the tokens into the profile's Keychain item, the
# identity into cli.json. Any doubt leaves the profile's earlier CLI login
# untouched, so a hand `claude auth login` as another account never
# overwrites a saved one. Every warning names the profile, because the app
# shows the outgoing re-save's warnings under the target's row.
cli_capture() {
  local name=$1 dir="$store/$1" live part rc=0 why
  [[ -z $cli_skip ]] && why=$(cli_blocker) || return 0
  if [[ -n $why ]]; then
    warning "$name: $why; saved the Desktop login only"
    return 0
  fi
  cli_live_read || rc=$?
  live=$cli_live
  if [[ $rc -eq 44 || $(cli_signed_in_as) != "$(live_account)" ]]; then
    warning "$name: Claude Code is signed in as a different account, or signed out; saved the Desktop login only"
    return 0
  elif [[ $rc -ne 0 ]]; then
    warning "$name: the Keychain helper exited $rc reading the CLI login; saved the Desktop login only"
    return 0
  fi
  if ! part=$(jq -c '{claudeAiOauth, trustedDeviceToken} | with_entries(select(.value != null))' <<< "$live" 2> /dev/null); then
    warning "$name: the live CLI login is not valid JSON; saved the Desktop login only"
    return 0
  fi
  keychain_put "$mp_service" "$name" <<< "$part" || {
    warning "$name: the Keychain helper exited $? saving the CLI login; saved the Desktop login only"
    return 0
  }
  jq_write "$dir/cli.json" '{oauthAccount}' "$claude_json" \
    || warning "$name: could not write $dir/cli.json; the CLI login is in the Keychain but not claimed; save $name again"
}

# The CLI's locks are directories: mkdir acquires, rmdir releases, and a
# holder older than the threshold claude-swap uses for it (60, 60 and 10 s)
# is swept first. A held lock fails a switch before Desktop's config moves.
cli_locks=()
held_lock=''
cli_lock() {
  local dir=$1 stale=$2 i
  mkdir -p "$(dirname "$dir")"
  if [[ -d $dir ]] && (($(date +%s) - $(stat -f %m "$dir") > stale)); then rm -rf "$dir"; fi
  for ((i = 0; i < 5; i++)); do
    if mkdir "$dir" 2> /dev/null; then
      cli_locks+=("$dir")
      return 0
    fi
    sleep 1
  done
  held_lock=$dir
  return 1
}

cli_lock_all() {
  cli_lock "$cli_home/.oauth_refresh.lock" 60
  cli_lock "$cli_home.lock" 60
  cli_lock "$claude_json.lock" 10
}

# Runs from the EXIT trap too, so every rmdir tolerates an absent dir.
cli_unlock() {
  local dir
  for dir in ${cli_locks[@]+"${cli_locks[@]}"}; do rmdir "$dir" 2> /dev/null || true; done
  cli_locks=()
}

# A running claude is assumed to keep its token in memory and write it back
# on refresh (open test in desktop-internals.md); the warning is cheap.
cli_running_warning() {
  local pid
  pid=$(pgrep -x claude 2> /dev/null | head -1) || true
  [[ -z $pid ]] || warning "Claude Code is running (pid $pid); quit it first, or its next token refresh can overwrite the switched login"
}

# The live CLI item and identity, kept under the name of this run's backup
# folder (made here when backup_login has not run). Fails when either cannot
# be kept, so the caller writes nothing over a login that has no copy.
cli_backup() {
  local live=$1
  [[ -n $backup_dest ]] || backup_login
  if [[ -n $live ]] && ! keychain_put "$mp_service" "$(basename "$backup_dest")" <<< "$live"; then
    warning "could not back up the CLI login; switched Desktop only"
    return 1
  fi
  jq_write "$backup_dest/cli.json" '{oauthAccount}' "$claude_json" || {
    warning "could not write $backup_dest/cli.json; switched Desktop only"
    return 1
  }
}

# After a restore, claude itself must agree on the org; a mismatch is a
# warning naming the backup, never a rollback.
cli_verify() {
  local out org rc=0
  [[ -n $1 ]] && command -v claude > /dev/null || return 0
  out=$(claude auth status 2> /dev/null) || rc=$?
  if ((rc != 0)); then
    warning "claude auth status exited $rc; could not verify the CLI login (the previous login is in $backup_dest)"
    return 0
  fi
  org=$(jq -r '.orgId // empty' <<< "$out" 2> /dev/null) || org=''
  [[ $org == "$1" ]] || warning "Claude Code reports a different org; the previous login is in $backup_dest"
}

# The CLI part of a restore. The saved tokens replace only the account part
# of the live item; the shared MCP keys stay. A CLI already on the target
# account holds fresher tokens than the profile, so it is re-saved instead.
cli_restore() {
  local name=$1 dir="$store/$1" saved live merged rc=0 why
  if [[ ! -f $dir/cli.json ]]; then
    warning "no CLI login saved for $name; switched Desktop only"
    return 0
  fi
  why=$(cli_blocker)
  if [[ -n $why ]]; then
    warning "$why; switched Desktop only"
    return 0
  fi
  cli_live_read || rc=$?
  # The identity alone does not prove a login: the item must hold tokens too.
  if ((rc == 0)) && [[ $(cli_signed_in_as) == "$(jq -r .account "$dir/meta.json")" ]] \
    && jq -e '.claudeAiOauth != null' <<< "$cli_live" > /dev/null 2>&1; then
    cli_capture "$name"
    return 0
  fi
  if ((rc == 44)); then live=''; elif ((rc != 0)); then
    warning "the Keychain helper exited $rc reading the CLI login; switched Desktop only"
    return 0
  else
    live=$cli_live
  fi
  rc=0
  saved=$(keychain_get "$mp_service" "$name") || rc=$?
  if ((rc == 44)); then
    warning "the saved CLI login for $name is missing from the Keychain; run claude auth login, then save $name"
    return 0
  elif ((rc != 0)); then
    warning "the Keychain helper exited $rc reading the saved CLI login; switched Desktop only"
    return 0
  fi
  merged=$saved
  if [[ -n $live ]] && ! merged=$(jq -c --argjson s "$saved" 'del(.claudeAiOauth, .trustedDeviceToken) + $s' <<< "$live" 2> /dev/null); then
    warning "the live CLI login is not valid JSON; switched Desktop only"
    return 0
  fi
  cli_backup "$live" || return 0
  keychain_put "$cli_service" "$cli_account" <<< "$merged" || {
    warning "the Keychain helper exited $? writing the CLI login; the previous login is in $backup_dest"
    return 0
  }
  # The identity file is written the way the CLI writes it (2 spaces, final
  # newline). The item and the file must agree, since the file is the
  # fingerprint every later run trusts: a failed write puts the item back.
  if ! { (umask 077 && jq --indent 2 --slurpfile c "$dir/cli.json" '.oauthAccount = $c[0].oauthAccount' "$claude_json" > "$claude_json.tmp") \
    && mv "$claude_json.tmp" "$claude_json"; }; then
    rm -f "$claude_json.tmp" 2> /dev/null || true
    if { [[ -n $live ]] && keychain_put "$cli_service" "$cli_account" <<< "$live"; } || { [[ -z $live ]] && keychain_delete "$cli_service" "$cli_account"; }; then
      warning "could not write $claude_json; the CLI login was put back, switched Desktop only"
    else
      warning "could not write $claude_json, and the previous CLI item could not be put back; it is in $backup_dest"
    fi
    return 0
  fi
  # claude-swap reports the CLI takes these locks on refresh (unverified here),
  # so they are released before claude is asked.
  cli_unlock
  cli_verify "$(jq -r '.oauthAccount.organizationUuid // empty' "$dir/cli.json")"
}

# BSD pgrep never reports its own ancestors, so from a shell inside Desktop
# (the Code tab's terminal) plain pgrep says "not running" while -a finds it.
desktop_running() { pgrep -axq Claude; }
inside_desktop() { ! pgrep -xq Claude && pgrep -axq Claude; }

wait_gone() {
  local i
  for ((i = 0; i < $1 * 2; i++)); do
    desktop_running || return 0
    sleep 0.5
  done
  ! desktop_running
}

# The cookie database is locked and config.json rewritten while the app runs.
desktop_quit() {
  desktop_running || return 0
  info "Quitting Claude"
  osascript -e 'tell application "Claude" to quit' > /dev/null || true
  wait_gone 8 && return 0
  pkill -x Claude || true
  wait_gone 10 || fail "Claude did not quit; quit it by hand and retry"
}

desktop_launch() {
  info "Launching Claude"
  open -a Claude
}

signed_in() { jq -e '.["oauth:tokenCacheV2"] | type == "string" and length > 0' "$config" > /dev/null; }

live_account() {
  signed_in || return 0
  jq -r '.lastKnownAccountUuid // empty' "$config"
}

# The saved profile whose account is signed in now, if any.
active_profile() {
  local live meta
  live=$(live_account)
  [[ -n $live ]] || return 0
  for meta in "$store"/*/meta.json; do
    [[ -f $meta ]] || continue
    if [[ $(jq -r .account "$meta") == "$live" ]]; then
      basename "$(dirname "$meta")"
      return 0
    fi
  done
}

# Copy the cookie files from one folder to another, removing a destination
# whose source is absent, so a profile restores exactly what it saved.
copy_cookies() {
  local f
  for f in Cookies Cookies-journal; do
    if [[ -f $1/$f ]]; then cp -p "$1/$f" "$2/$f"; else rm -f "$2/$f"; fi
  done
}

# Keep the live login (config.json plus cookies) under a timestamped folder,
# newest ten only: each one holds encrypted tokens.
backup_dest=''
backup_login() {
  local old n
  backup_dest="$backups/login-$(date +%Y%m%d-%H%M%S)-$$"
  (umask 077 && mkdir -p "$backup_dest")
  cp -p "$config" "$backup_dest/config.json"
  copy_cookies "$cookies" "$backup_dest"
  echo "Backed up the current login to $backup_dest"
  # BSD head has no negative count, so compute how many to drop. A pruned
  # folder's CLI backup item goes with it (44: a 0.2.x folder had none).
  n=$(ls -1d "$backups"/login-*/ 2> /dev/null | wc -l | tr -d ' ')
  if ((n > 10)); then
    for old in $(ls -1d "$backups"/login-*/ | sort | head -n $((n - 10))); do
      rm -rf "$old"
      keychain_delete "$mp_service" "$(basename "$old")" || warning "could not delete the Keychain item for $old"
    done
  fi
}

# A profile set aside keeps its Desktop login in backups/; its CLI item goes,
# the token being recoverable only through claude auth login.
profile_set_aside() {
  (umask 077 && mkdir -p "$backups")
  mv "$store/$1" "$backups/profile-$1-$(date +%Y%m%d-%H%M%S)-$$"
  keychain_delete "$mp_service" "$1" || warning "could not delete the CLI login item for $1"
}

profile_save() {
  local name=$1 dir="$store/$1" live saved other
  signed_in || fail "Claude Desktop is signed out: sign in first, then save"
  live=$(live_account)
  if [[ -f $dir/meta.json ]]; then
    saved=$(jq -r .account "$dir/meta.json")
    if [[ $saved != "$live" ]]; then
      [[ -n $force ]] || refuse "$name already holds account ${saved:0:8}, not the signed-in ${live:0:8}: pick another name, or pass --force to replace it"
      profile_set_aside "$name"
      echo "Moved the old $name profile into $backups"
    fi
  fi
  other=$(active_profile)
  [[ -z $other || $other == "$name" ]] || warning "$other already holds this account; both names will switch to it"
  (umask 077 && mkdir -p "$dir")
  jq_write "$dir/config.json" --argjson k "$auth_keys" \
    'with_entries(select(.key as $x | $k | index($x)))' "$config"
  copy_cookies "$cookies" "$dir"
  jq_write "$dir/meta.json" -n --arg a "$live" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{account: $a, savedAt: $t}'
  cli_capture "$name"
  echo "Saved the signed-in account as $name"
}

profile_restore() {
  local name=$1 dir="$store/$1"
  backup_login
  jq_write "$config" --slurpfile p "$dir/config.json" --argjson k "$auth_keys" \
    'reduce $k[] as $x (.; if $p[0] | has($x) then .[$x] = $p[0][$x] else del(.[$x]) end)' \
    "$config"
  copy_cookies "$dir" "$cookies"
  cli_restore "$name"
  echo "Restored $name"
}

# True when src has later activity than dst: lastActivityAt from the JSON, or
# the file mtime when either lacks it or isn't valid JSON.
is_newer() {
  local src=$1 dst=$2 cmp
  [[ -e $dst ]] || return 0
  cmp=$(jq -rn --slurpfile a "$src" --slurpfile b "$dst" \
    '$a[0].lastActivityAt as $x | $b[0].lastActivityAt as $y
     | if $x == null or $y == null then "mtime" elif $x > $y then "yes" else "no" end' \
    2> /dev/null) || cmp=mtime
  case $cmp in
    yes) return 0 ;;
    mtime) [[ $src -nt $dst ]] ;;
    *) return 1 ;;
  esac
}

index_sync() {
  local dirs=() srcs=() target src name id tombstones=" " f count
  for f in "$sessions"/*/*/; do
    [[ -d $f ]] && dirs+=("${f%/}")
  done
  [[ ${#dirs[@]} -gt 0 ]] || {
    echo "No Code tab session lists found"
    return 0
  }
  for f in "$sessions"/*/*/deleted_*; do
    [[ -e $f ]] || continue
    id=${f##*/deleted_}
    tombstones+="${id%.json} "
  done
  for f in "$sessions"/*/*/local_*.json; do
    [[ -f $f ]] && srcs+=("$f")
  done
  [[ ${#srcs[@]} -gt 0 ]] || {
    echo "No Code tab sessions to sync"
    return 0
  }
  for target in "${dirs[@]}"; do
    count=0
    for src in "${srcs[@]}"; do
      [[ ${src%/*} != "$target" ]] || continue
      name=${src##*/}
      id=${name#local_}
      [[ $tombstones == *" ${id%.json} "* ]] && continue
      # cp -p keeps the mtime, so an equal mtime plus equal bytes means already
      # synced; cmp is far cheaper than the jq run per pair below.
      if [[ -e $target/$name && ! $src -nt $target/$name && ! $target/$name -nt $src ]] \
        && cmp -s "$src" "$target/$name"; then
        continue
      fi
      if is_newer "$src" "$target/$name"; then
        cp -p "$src" "$target/$name"
        count=$((count + 1))
      fi
    done
    echo "${target#"$sessions"/}: $count written"
  done
}

# The app encrypts its token cache like Chromium: PBKDF2-SHA1 of the
# "Claude Safe Storage" login-keychain password (salt saltysalt, 1003 rounds,
# 16 bytes) as an AES-128-CBC key, IV of 16 spaces, "v10" prefix.
# The password goes to python3 on stdin, never on a command line. System
# python3 has PBKDF2; macOS's LibreSSL `openssl` lacks `kdf` but has `enc`.
safe_storage_key() {
  security find-generic-password -w -s "Claude Safe Storage" 2> /dev/null \
    | /usr/bin/python3 -c 'import hashlib, sys; print(hashlib.pbkdf2_hmac("sha1", sys.stdin.buffer.read().rstrip(b"\n"), b"saltysalt", 1003, 16).hex())' \
    || fail "Could not read \"Claude Safe Storage\" from the login Keychain"
}

# Prints the account's newest unexpired profile-scoped access token from a
# config.json; "cannot decrypt" when the cache does not open with this key.
access_token() {
  local key=$1 cfg=$2 account=$3 plain
  plain=$(jq -r '.["oauth:tokenCacheV2"] // empty' "$cfg" | base64 -d | tail -c +4 \
    | openssl enc -d -aes-128-cbc -K "$key" -iv 20202020202020202020202020202020 2> /dev/null) \
    || {
      echo "cannot decrypt"
      return 0
    }
  jq -r --arg a "acct:$account|" --argjson now "$(date +%s)000" '
      [to_entries[] | select(.key | startswith($a) and contains("user:profile"))
       | select(.value.expiresAt > $now)] | max_by(.value.expiresAt) | .value.token // empty' <<< "$plain"
}

usage_jq='
  def pct: (.utilization // 0 | floor | tostring) + "%";
  def at: if .resets_at then " (resets " + (.resets_at | try (sub("(\\.[0-9]+)?(\\+00:00|Z)$"; "Z") | fromdate | strflocaltime("%a %H:%M")) catch .) + ")" else "" end;
  "5h " + (.five_hour | pct) + (.five_hour | at) + "  7d " + (.seven_day | pct) + (.seven_day | at)'

# The raw usage body for one config.json, or "error: <reason>".
usage_fetch() {
  local key=$1 cfg=$2 account=$3 token code body msg=''
  token=$(access_token "$key" "$cfg" "$account")
  if [[ -z $token ]]; then
    msg='token expired, sign in and re-save'
  elif [[ $token == "cannot decrypt" ]]; then
    msg='cannot decrypt (the profile was saved on another Mac, or the app changed its key)'
  # The bearer header goes in on stdin so the token never sits in argv.
  elif ! body=$(printf 'header = "Authorization: Bearer %s"\n' "$token" \
    | curl -sS --max-time 10 -K - -w '\n%{http_code}' \
      -H "anthropic-beta: oauth-2025-04-20" https://api.anthropic.com/api/oauth/usage 2> /dev/null); then
    msg=unavailable
  else
    code=${body##*$'\n'}
    body=${body%$'\n'*}
    case $code in
      200) ;;
      401) msg='token expired, sign in and re-save' ;;
      429) msg='rate limited' ;;
      *) msg="unavailable (HTTP $code)" ;;
    esac
  fi
  [[ -z $msg ]] || {
    echo "error: $msg"
    return 0
  }
  jq -e . <<< "$body" > /dev/null 2>&1 || {
    echo "error: unreadable response"
    return 0
  }
  printf '%s\n' "$body"
}

# The 5h and 7d figures for one config.json as text, or a short reason.
usage_line() {
  local body
  body=$(usage_fetch "$@")
  case $body in
    error:\ *) echo "${body#error: }" ;;
    *) jq -r "$usage_jq" <<< "$body" ;;
  esac
}

# The same figures as one JSON object {name, fiveHour?, sevenDay?} or
# {name, error}; a window with a null utilization is left out.
usage_object() {
  local name=$1 body
  shift
  body=$(usage_fetch "$@")
  case $body in
    error:\ *) jq -n --arg name "$name" --arg error "${body#error: }" '{name: $name, error: $error}' ;;
    *) jq --arg name "$name" '
      def win(key): if .utilization == null then {} else
        {(key): ({utilization} + (if .resets_at then {resetsAt: (.resets_at | sub("(\\.[0-9]+)?(\\+00:00|Z)$"; "Z"))} else {} end))} end;
      {name: $name} + ((.five_hour // {}) | win("fiveHour")) + ((.seven_day // {}) | win("sevenDay"))' <<< "$body" ;;
  esac
}

# One line per check, in a fixed order, no Keychain and no network. Exits 1
# when any fail: line was printed.
doctor_report() {
  local status=0 tool mode meta dir name file n legacy
  if [[ -f $config ]]; then echo "ok: config: $config"; else
    echo "fail: config: no $config (open Claude Desktop once first)"
    status=1
  fi
  if command -v jq > /dev/null; then echo "ok: jq"; else
    echo "fail: jq: not on PATH (brew install jq)"
    status=1
  fi
  if xcode-select -p > /dev/null 2>&1; then echo "ok: Command Line Tools (the system python3 for the CLI login and usage)"; else echo "warn: Command Line Tools: not installed (xcode-select --install), needed for the CLI login and usage"; fi
  for tool in 'fzf:the picker' 'openssl:usage (token decrypt)' 'curl:usage (the usage endpoint)'; do
    if command -v "${tool%%:*}" > /dev/null; then echo "ok: ${tool%%:*}"; else echo "warn: ${tool%%:*}: not on PATH, needed for ${tool#*:}"; fi
  done
  if [[ -d $store ]]; then
    mode=$(stat -f %Lp "$store")
    if [[ $mode == 700 ]]; then echo "ok: store: $store"; else echo "warn: store: mode $mode, expected 700 (chmod 700 \"$store\")"; fi
  else
    echo "warn: store: nothing saved yet ($store)"
  fi
  for dir in "$store"/*/; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    for file in "$dir"config.json "$dir"meta.json "$dir"Cookies "$dir"Cookies-journal "$dir"cli.json; do
      [[ -f $file ]] || continue
      mode=$(stat -f %Lp "$file")
      [[ $mode == 600 ]] || echo "warn: $name: $(basename "$file") is mode $mode, expected 600"
    done
    if [[ ! -f ${dir}meta.json ]]; then
      echo "fail: $name: missing meta.json"
      status=1
    elif [[ ! -f ${dir}config.json ]]; then
      echo "fail: $name: missing config.json (re-save it)"
      status=1
    elif ! jq -e '.["oauth:tokenCacheV2"] | type == "string" and length > 0' "${dir}config.json" > /dev/null 2>&1; then
      echo "fail: $name: empty oauth:tokenCacheV2 (re-save it)"
      status=1
    else
      echo "ok: $name"
    fi
    [[ -f ${dir}cli.json ]] || echo "warn: $name: no CLI login saved (claude auth login, then save $name)"
  done
  [[ -z ${CLAUDE_CONFIG_DIR:-} ]] || echo "warn: CLAUDE_CONFIG_DIR is set; the CLI login is not saved or switched"
  n=$(ls -1d "$backups"/login-*/ 2> /dev/null | wc -l | tr -d ' ')
  echo "ok: backups: $n saved logins in $backups"
  if desktop_running; then echo "ok: desktop: running"; else echo "ok: desktop: not running"; fi
  legacy="$config_home/dotfiles/claude-desktop-accounts"
  [[ ! -d $legacy ]] || echo "warn: legacy store: $legacy still exists (it moves on the first run without CLAUDE_MULTIPASS_DIR)"
  return $status
}

# One line per saved account plus the live login when it is unsaved. The
# fetches run in parallel; one key derivation serves them all.
usage_report() {
  local only=${1:-} key out meta dir name live i=0
  [[ -z $only ]] || require_profile "$only"
  key=$(safe_storage_key)
  out=$(mktemp -d)
  for meta in "$store"/*/meta.json; do
    [[ -f $meta ]] || continue
    dir=$(dirname "$meta")
    name=${dir##*/}
    [[ -z $only || $only == "$name" ]] || continue
    i=$((i + 1))
    usage_entry "$name" "$key" "$dir/config.json" "$(jq -r .account "$meta")" > "$out/$(printf %03d "$i")" &
  done
  live=$(live_account)
  if [[ -z $only && -n $live && -z $(active_profile) ]]; then
    usage_entry "(signed in)" "$key" "$config" "$live" > "$out/999" &
  fi
  wait
  if [[ -n $json ]]; then
    if [[ -n $(ls -A "$out") ]]; then jq -s '{profiles: .}' "$out"/*; else echo '{"profiles":[]}'; fi
  else
    cat "$out"/* 2> /dev/null || true
  fi
  rm -rf "$out"
}

# One account's entry in the report, text line or JSON object.
usage_entry() {
  if [[ -n $json ]]; then
    usage_object "$@"
  else
    printf '%-16s %s\n' "$1" "$(usage_line "${@:2}")"
  fi
}

count_sessions() {
  [[ -d $1 ]] || {
    echo 0
    return 0
  }
  find "$1" -name 'local_*.json' -type f | wc -l | tr -d ' '
}

# The signed-in saved account's name, or "not saved", or "signed out".
current_profile() {
  local active
  signed_in || {
    echo "signed out"
    return 0
  }
  active=$(active_profile)
  echo "${active:-not saved}"
}

list_profiles() {
  local live meta dir account mark any=''
  live=$(live_account)
  for meta in "$store"/*/meta.json; do
    [[ -f $meta ]] || continue
    any=1
    dir=$(dirname "$meta")
    account=$(jq -r .account "$meta")
    mark='  '
    [[ $account == "$live" ]] && mark='* '
    printf '%s%-16s %s  %s  %s sessions\n' "$mark" "${dir##*/}" "${account:0:8}" \
      "$(jq -r .savedAt "$meta")" "$(count_sessions "$sessions/$account")"
  done
  [[ -n $any ]] || echo "No saved accounts yet: run claude-multipass save <name> for the signed-in one, add <name> for another"
  [[ -z $live || -n $(active_profile) ]] \
    || echo "Signed in now: ${live:0:8} (not saved; run: claude-multipass save <name>)"
}

# One JSON object for the menu bar app; [inputs] gathers the bare objects
# into an array, [] when there are none
list_json() {
  local meta account profiles='' signed_in=false running=false cli_saved
  for meta in "$store"/*/meta.json; do
    [[ -f $meta ]] || continue
    account=$(jq -r .account "$meta")
    cli_saved=false
    [[ ! -f ${meta%/*}/cli.json ]] || cli_saved=true
    profiles+=$(jq -n --arg name "$(basename "$(dirname "$meta")")" --arg account "$account" \
      --arg savedAt "$(jq -r .savedAt "$meta")" --argjson sessions "$(count_sessions "$sessions/$account")" \
      --argjson cliSaved "$cli_saved" \
      '{name: $name, account: $account, savedAt: $savedAt, sessions: $sessions, cliSaved: $cliSaved}')
  done
  signed_in && signed_in=true
  desktop_running && running=true
  jq -n --arg v "$version" --argjson signedIn "$signed_in" --argjson running "$running" \
    --arg current "$(active_profile)" \
    '{version: $v, signedIn: $signedIn, desktopRunning: $running, current: (if $current == "" then null else $current end), profiles: [inputs]}' <<< "$profiles"
}

require_profile() {
  [[ -f $store/$1/meta.json && -f $store/$1/config.json ]] \
    || fail "No saved account named $1 (see: claude-multipass list)"
}

valid_name() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ && $1 != . && $1 != .. ]] \
    || fail "Give a name made of letters, digits, . _ - (got: $1)"
}

# The profile's CLI item is keyed by name, so it moves too (44: none saved).
profile_rename() {
  local v rc=0
  require_profile "$1"
  [[ ! -e $store/$2 ]] || fail "$2 already exists"
  mv "$store/$1" "$store/$2"
  v=$(keychain_get "$mp_service" "$1") || rc=$?
  if ((rc == 0)); then
    if keychain_put "$mp_service" "$2" <<< "$v"; then
      keychain_delete "$mp_service" "$1" || warning "the CLI login is now under $2 but its old item $1 could not be deleted"
    else
      rm -f "$store/$2/cli.json"
      warning "could not move the CLI login to $2 (the old item stays under $1); run claude auth login, then save $2"
    fi
  elif ((rc != 44)); then
    warning "the Keychain helper exited $rc reading the CLI login; run claude auth login, then save $2"
  fi
  echo "Renamed $1 to $2"
}

profile_show() {
  local account org n
  account=$(jq -r .account "$store/$1/meta.json")
  echo "$1"
  echo "account ${account:0:8}"
  echo "saved at $(jq -r .savedAt "$store/$1/meta.json")"
  if [[ -f $store/$1/cli.json ]]; then echo "CLI login: saved"; else echo "CLI login: not saved"; fi
  for org in "$sessions/$account"/*/; do
    [[ -d $org ]] || continue
    n=$(count_sessions "$org")
    org=${org%/}
    org=${org##*/}
    echo "org ${org:0:8}: $n sessions"
  done
}

# Name first so fzf's {1} is the name; the signed-in mark moves to the end.
pick_profile() {
  local rows choice
  rows=$(list_profiles | sed -nE 's/^\* (.* sessions)$/\1  (signed in)/p; s/^  (.* sessions)$/\1/p')
  [[ -n $rows ]] || {
    list_profiles
    return 0
  }
  # fzf exits 130 on esc and 1 with nothing matched: both mean no change.
  choice=$(fzf --header 'Enter: switch   esc: quit' \
    --preview "$(printf %q "$0") show {1}" <<< "$rows") || return 0
  if [[ -n $relaunch ]]; then
    main switch "${choice%% *}"
  else
    main switch "${choice%% *}" --no-relaunch
  fi
}

profile_remove() {
  require_profile "$1"
  profile_set_aside "$1"
  echo "Moved $1 to $backups (Desktop's current login is untouched)"
}

# One-time move of the store the tool kept while it lived in a dotfiles repo.
# Only for the default location: an explicit CLAUDE_MULTIPASS_DIR (the
# self-check's fixtures) must never move the real store.
migrate_store() {
  local legacy="$config_home/dotfiles/claude-desktop-accounts"
  [[ -z ${CLAUDE_MULTIPASS_DIR:-} && ! -e $store && -d $legacy ]] || return 0
  (umask 077 && mkdir -p "$root")
  mv "$legacy" "$store"
  echo "Moved the saved accounts from $legacy to $store" >&2
  if [[ -d $legacy-backups ]]; then
    if [[ -e $backups ]]; then
      warning "Left $legacy-backups in place: $backups already exists"
    else
      mv "$legacy-backups" "$backups"
    fi
  fi
}

main() {
  local cmd=${1:-} names=() name='' relaunch=1 force='' json='' arg active saved live
  [[ -n $cmd ]] || {
    if [[ -t 0 ]] && command -v fzf > /dev/null; then
      cmd=pick
    else
      usage
      exit 2
    fi
  }
  [[ $# -eq 0 ]] || shift
  for arg in "$@"; do
    case $arg in
      --no-relaunch) relaunch= ;;
      --force) force=1 ;;
      --json) json=1 ;;
      -h | --help) cmd=help ;;
      -*) fail "Unknown option: $arg" ;;
      *) names+=("$arg") ;;
    esac
  done
  [[ -z $force || $cmd == sync || $cmd == switch || $cmd == save ]] || fail "--force applies to sync, switch and save"
  [[ -z $json || $cmd == list || $cmd == usage ]] || fail "--json applies to list and usage"

  case $cmd in
    --version)
      echo "claude-multipass $version"
      return 0
      ;;
    -h | --help | help)
      usage
      return 0
      ;;
    list | sync | current | pick | doctor) [[ ${#names[@]} -eq 0 ]] || fail "$cmd takes no name" ;;
    usage)
      [[ ${#names[@]} -le 1 ]] || fail "usage takes at most one name"
      [[ ${#names[@]} -eq 0 ]] || valid_name "${names[0]}"
      ;;
    save | switch | add | remove | show)
      [[ ${#names[@]} -eq 1 ]] || fail "$cmd takes exactly one name"
      name=${names[0]}
      valid_name "$name"
      ;;
    rename)
      [[ ${#names[@]} -eq 2 ]] || fail "rename takes the old name and the new name"
      valid_name "${names[0]}"
      valid_name "${names[1]}"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
  if [[ $cmd == doctor ]]; then
    doctor_report
    return $?
  fi
  [[ -f $config ]] || fail "No $config: open Claude Desktop once first"
  migrate_store

  case $cmd in
    list)
      if [[ -n $json ]]; then list_json; else list_profiles; fi
      return 0
      ;;
    sync)
      if desktop_running && [[ -z $force ]]; then
        refuse "Claude Desktop is running: quit it first, or pass --force"
      fi
      index_sync
      return 0
      ;;
    rename)
      profile_rename "${names[0]}" "${names[1]}"
      return 0
      ;;
    usage)
      usage_report "${names[0]:-}"
      return 0
      ;;
    current)
      current_profile
      return 0
      ;;
    pick)
      command -v fzf > /dev/null || fail "pick needs fzf"
      pick_profile
      return 0
      ;;
    remove)
      profile_remove "$name"
      return 0
      ;;
    show)
      require_profile "$name"
      profile_show "$name"
      return 0
      ;;
    save)
      signed_in || fail "Claude Desktop is signed out: sign in first, then save"
      # Decided before the quit, so a refused save never bounces Desktop.
      if [[ -f $store/$name/meta.json && -z $force ]]; then
        saved=$(jq -r .account "$store/$name/meta.json")
        live=$(live_account)
        [[ $saved == "$live" ]] || refuse "$name already holds account ${saved:0:8}, not the signed-in ${live:0:8}: pick another name, or pass --force to replace it"
      fi
      ;;
    switch)
      require_profile "$name"
      if signed_in && [[ -z $(active_profile) && -z $force ]]; then
        refuse "The signed-in account isn't saved and would need its email code again: run save <name> first, or pass --force"
      fi
      ;;
  esac

  # Everything past here needs the app quit. Relaunch from the trap so an
  # error midway still brings it back. Quitting Desktop from a shell it owns
  # would end that shell mid-switch, so refuse instead.
  ! inside_desktop || fail "This shell runs inside Claude Desktop; quitting it would end this session. Run $cmd from Terminal or the menu bar app"
  desktop_quit
  # relaunch is main's local, so the trap text is chosen now, not at exit.
  if [[ -n $relaunch ]]; then trap 'cli_unlock; desktop_launch' EXIT; else trap cli_unlock EXIT; fi
  # The CLI's own locks guard its login while a save reads it or a switch
  # writes it. They are taken only when claude.json exists, because
  # cli_restore writes nothing without it.
  cli_running_warning
  if [[ -f $claude_json ]] && ! cli_lock_all; then
    [[ $cmd != switch ]] || fail "Claude Code holds $held_lock; retry in a moment"
    warning "Claude Code holds $held_lock; saved the Desktop login only"
    cli_skip=1
  fi
  active=$(active_profile)
  case $cmd in
    save) profile_save "$name" ;;
    switch)
      if [[ $active == "$name" ]]; then
        echo "$name is already signed in"
        # Cookies are idempotent to re-copy and repair a switch that died midway;
        # the CLI part repairs the same way, backing up only when it writes.
        copy_cookies "$store/$name" "$cookies"
        cli_restore "$name"
      else
        # Re-save first so token refreshes since the last save aren't lost.
        [[ -z $active ]] || profile_save "$active"
        profile_restore "$name"
      fi
      index_sync
      ;;
    add)
      if [[ -n $active ]]; then
        profile_save "$active"
      elif signed_in; then
        warning "The signed-in account isn't saved; it will need its email code again"
      fi
      backup_login
      jq_write "$config" --argjson k "$auth_keys" 'delpaths($k | map([.]))' "$config"
      rm -f "$cookies/Cookies" "$cookies/Cookies-journal"
      info "Sign in with the new account (email code), then claude auth login for the terminal, then run: claude-multipass save $name"
      ;;
  esac
}

main "$@"
