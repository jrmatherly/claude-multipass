{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "bashEditDiffEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-gate.sh",
            "args": [],
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Running pnpm check before the commit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|mcp__serena__(replace_content|replace_in_files|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|safe_delete_symbol))$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-bash-edits.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Linting files the command wrote"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "Bash(pnpm format *)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(test/check.sh *)",
      "Bash(bash test/*)",
      "Bash(.claude/hooks/test-*)"
    ],
    "ask": [
      "Bash(claude-multipass switch *)",
      "Bash(claude-multipass add *)",
      "Bash(claude-multipass save *)",
      "Bash(claude-multipass remove *)",
      "Bash(claude-multipass rename *)",
      "Bash(claude-multipass sync *)",
      "Bash(claude-multipass usage *)",
      "Bash(bin/claude-multipass switch *)",
      "Bash(bin/claude-multipass add *)",
      "Bash(bin/claude-multipass save *)",
      "Bash(bin/claude-multipass remove *)",
      "Bash(bin/claude-multipass rename *)",
      "Bash(bin/claude-multipass sync *)",
      "Bash(bin/claude-multipass usage *)",
      "Bash(./bin/claude-multipass switch *)",
      "Bash(./bin/claude-multipass add *)",
      "Bash(./bin/claude-multipass save *)",
      "Bash(./bin/claude-multipass remove *)",
      "Bash(./bin/claude-multipass rename *)",
      "Bash(./bin/claude-multipass sync *)",
      "Bash(./bin/claude-multipass usage *)"
    ]
  }
}
